# All optional — defaults live in src/helmet_detection/config.py
HELMET_WEIGHTS=weights/best.pt
HELMET_CONF=0.40
HELMET_DEVICE=          # cpu | 0 | mps  (empty = auto)
HELMET_HALF=0           # 1 = FP16 on CUDA
HELMET_TRACK=1          # 1 = ByteTrack de-duplication
HELMET_FRAME_SKIP=1
HELMET_COOLDOWN=3
HELMET_OUTPUT_DIR=outputs
